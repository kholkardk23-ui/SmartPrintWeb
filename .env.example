# ============================================================
# SMARTPRINT PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL PyMySQL)
# ------------------------------------------------------------
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl-mode=REQUIRED
DATABASE_URL=mysql+pymysql://smartprint_user:YOUR_PASSWORD@localhost:3306/smartprint

# ------------------------------------------------------------
# 2. FILE STORAGE SETTINGS (Persistent Storage)
# ------------------------------------------------------------
# For local development: ./uploads
# For Render production with persistent disk: /data/uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------
# 3. PRINTING PRICING (Stage 2)
# ------------------------------------------------------------
BW_PRICE_PER_PAGE=3.0
COLOR_PRICE_PER_PAGE=10.0
CURRENCY=INR

# ------------------------------------------------------------
# 4. PAYMENT GATEWAY SELECTION
# ------------------------------------------------------------
PAYMENT_ENABLED=true
PAYMENT_PROVIDER=payu
UPI_ID=9823555453@kotakbank
UPI_NAME=SmartPrint Kiosk

# ------------------------------------------------------------
# 5. PAYU INDIA PAYMENT GATEWAY
# ------------------------------------------------------------
# Mode: "test" for sandbox integration, "live" for production customer payments
PAYU_MODE=test
PAYU_MERCHANT_KEY=YOUR_PAYU_MERCHANT_KEY
PAYU_MERCHANT_SALT=YOUR_PAYU_MERCHANT_SALT

# Optional: endpoints are auto-selected according to PAYU_MODE
# Test endpoints:
# PAYU_PAYMENT_URL=https://test.payu.in/_payment
# PAYU_VERIFY_URL=https://test.payu.in/merchant/postservice.php?form=2
# Live endpoints:
# PAYU_PAYMENT_URL=https://secure.payu.in/_payment
# PAYU_VERIFY_URL=https://info.payu.in/merchant/postservice.php?form=2

# Callback endpoints on backend:
PAYU_SUCCESS_URL=https://smartprintweb.onrender.com/api/payments/payu/response
PAYU_FAILURE_URL=https://smartprintweb.onrender.com/api/payments/payu/response

# ------------------------------------------------------------
# 6. DOMAINS & CORS (Production URLs)
# ------------------------------------------------------------
FRONTEND_URL=https://smart-print-web-gules.vercel.app
BACKEND_URL=https://smartprintweb.onrender.com
CORS_ORIGINS=https://smart-print-web-gules.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# 7. FRONTEND VITE ENVIRONMENT (.env in frontend/)
# ------------------------------------------------------------
# VITE_API_URL=https://smartprintweb.onrender.com
# VITE_CUSTOMER_WEBSITE_URL=https://smart-print-web-gules.vercel.app/
